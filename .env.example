# Copy this file to .env.local and fill in what you need. Never commit .env.local.

# Database (optional locally: without these, data is saved to data/chog-league.json)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Signs the sign-in cookie. Required in production: any long random string.
SESSION_SECRET=

# Monad (defaults shown)
NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_CHOG_NFT_ADDRESS=0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763

# Local testing without internet: made-up prices (ignored on Vercel)
# CHOG_FAKE_PRICES=1
